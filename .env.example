# ==============================================================================
# ORACLE: Live Intelligence Copilot Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Core Application
APP_NAME=ORACLE
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Persistence Directories
DATA_DIR=backend/data
GRAPH_PERSIST_PATH=backend/data/knowledge_graph.json
CHROMA_PERSIST_DIR=backend/data/chroma_db

# LLM Provider Configuration
# Supported options: mock | openai | anthropic | gemini | ollama
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Provider API Keys (Leave blank if using mock or ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Ingestion Settings
INGESTION_INTERVAL_MINUTES=30
MAX_ITEMS_PER_FEED=25
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT=ORACLE-IntelligenceCopilot/1.0 (+https://github.com/oracle-copilot)

# Vector & Embedding Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Autonomous Scheduler & Monitoring
SCHEDULER_ENABLED=True
SCHEDULER_TICK_SECONDS=15
